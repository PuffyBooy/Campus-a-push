# Copy to .env for local runs (never commit .env). In GitHub Actions these are repository secrets.
TYPO3_BACKEND_URL=https://www.example.org/typo3
TYPO3_USERNAME=publisher-bot
TYPO3_PASSWORD=change-me
OPENAI_API_KEY=sk-...
PIXABAY_API_KEY=...
WEBSITE_BASE_URL=https://www.example.org

# Optional
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...      # Slack/Teams/generic JSON webhook
# TYPO3_STORAGE_STATE=<base64 of a storage-state file>       # only for sites with MFA, see README
# CHROMIUM_EXECUTABLE=/path/to/chrome                          # use a specific Chromium binary
# BOT_PUBLISHING_ENABLED=false                                 # override publishing.enabled
# BOT_STATE_BACKEND=local                                      # local | git_branch
